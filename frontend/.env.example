# ==============================================================================
# Aulten Digital - TaskFlow Enterprise CRM Frontend Configuration
#
# Copy this file to `frontend/.env` for local development (if overriding defaults).
# Configure these variables in the Vercel Dashboard for production deployments.
# NEVER place backend secrets (database passwords, API keys) in frontend env files.
# ==============================================================================

# Backend API Base URL
# In local development:
#   Leave blank or unset to let Vite proxy requests to http://localhost:3001 via vite.config.js.
# In production on Vercel:
#   Set this to your live Render backend URL.
#   Example: https://employee-task-dashboard-g2ug.onrender.com
#   Note: Do not include trailing slashes. Both with and without `/api` are handled automatically.
VITE_API_BASE_URL=https://employee-task-dashboard-g2ug.onrender.com
