# ==============================================================================
# Aulten Digital - TaskFlow Enterprise CRM Backend Configuration
# Copy into your local .env file; replace placeholders. Never commit real secrets.
# ==============================================================================

# Server configuration
PORT=3001
NODE_ENV=development

# PostgreSQL connection string (Neon, Render, Supabase, AWS RDS, or local)
# Neon connection strings should include sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Safe Demo Seeding (Used by `npm run db:seed`)
DEMO_PASSWORD=TaskFlowDemo@2026!

# Initial Admin Provisioning (Used by `npm run provision:admin`)
# If ADMIN_PASSWORD is omitted, a 24-character cryptographically secure password is generated and printed once.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@aulten.example.com
ADMIN_PASSWORD=

# Optional SMTP Email Configuration (for password reset emails)
# When omitted, password reset tokens are safely simulated in non-production responses without sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
