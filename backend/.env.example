# ==============================================================================
# Aulten Digital - TaskFlow Enterprise CRM Backend Configuration
#
# Copy this file to `backend/.env` for local development.
# Configure these variables in the Render Dashboard for production.
# NEVER commit real passwords, secrets, or connection strings to Git.
# ==============================================================================

# ─── Server Environment ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Allowed Frontend Origins (CORS & CSRF) ───────────────────────────────────
# Comma-separated origins permitted to connect with credentials.
# In production on Render, set this to your Vercel frontend URL.
# Example: https://employee-task-dashboard-chi.vercel.app,https://crm.aultendigital.com
FRONTEND_URL=http://localhost:5173,https://employee-task-dashboard-chi.vercel.app

# ─── PostgreSQL Database Connection ───────────────────────────────────────────
# Connection string from Render, Neon, Supabase, or AWS RDS.
# Most cloud providers require SSL (append ?sslmode=require if needed).
# Example: postgresql://taskflow_user:YOUR_PASSWORD@ep-sample-1234.us-east-2.aws.neon.tech/taskflow_db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Database SSL Options
# In production, SSL is enabled automatically for remote hosts.
# Set DATABASE_SSL=true or false to override.
# Set DATABASE_SSL_REJECT_UNAUTHORIZED=true only if using a certified CA root bundle.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ─── Live Staging & Integration Test Database ─────────────────────────────────
# Used ONLY by `npm run test:integration`.
# Must point to an isolated, disposable test database.
# NEVER set this to your production DATABASE_URL.
TEST_DATABASE_URL=

# ─── Session & Cookie Security ────────────────────────────────────────────────
# In cross-origin setups (e.g. Vercel frontend + Render backend),
# SameSite must be 'none' and Secure must be true.
# In local development or same-origin custom domains, 'lax' is used.
COOKIE_SAME_SITE=
COOKIE_SECURE=

# ─── Demo Mode Access Gate ────────────────────────────────────────────────────
# Demo user switching (/api/auth/demo-users and /api/auth/switch-demo-user)
# is disabled by default in production (NODE_ENV=production).
# Set ALLOW_DEMO_SWITCH=true ONLY in dedicated evaluation/staging environments.
ALLOW_DEMO_SWITCH=false

# Demo database seeding password (used by `npm run db:seed`)
DEMO_PASSWORD=TaskFlowDemo@2026!

# ─── Initial Admin Provisioning ───────────────────────────────────────────────
# Used by `npm run provision:admin`.
# If ADMIN_PASSWORD is left blank, a cryptographically secure 24-character
# password will be generated and printed to stdout once.
# If re-run on an existing admin whose password is already set, the existing
# password is preserved unless ADMIN_PASSWORD is explicitly set.
ADMIN_NAME=Dolly
ADMIN_EMAIL=admin@startizlabs.com
ADMIN_PASSWORD=
ORG_SLUG=startiz-labs
ORG_NAME=Startiz Labs

# ─── Optional SMTP Email Configuration (Password Resets) ─────────────────────
# When configured, password reset tokens are emailed to users.
# When omitted in non-production, simulation tokens are returned safely for testing.
# In production, reset instructions are generated silently without leaking tokens.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
